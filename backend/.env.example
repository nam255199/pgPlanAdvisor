# Copy to .env (or set as real environment variables / docker-compose
# environment entries) to override pgPlanAdvisor's defaults.
# Every setting is optional - the service runs with sane defaults with none of this set.
# See README.md "Configuration" for the full reference, including rule thresholds (PGPA_*
# variables in app/config.py's Thresholds class).

# --- Service ---
# PGPA_LOG_LEVEL=INFO
# PGPA_LOG_JSON=false
# PGPA_CORS_ORIGINS=["http://localhost:5173"]
# PGPA_MAX_PLAN_BYTES=5000000

# --- Security (unset = open API, matching upstream default) ---
# PGPA_API_KEY=change-me

# --- Rate limiting ---
# PGPA_RATE_LIMIT_ENABLED=true
# PGPA_RATE_LIMIT_REQUESTS=60
# PGPA_RATE_LIMIT_WINDOW_SECONDS=60

# --- History persistence (SQLite, disabled by default) ---
# PGPA_HISTORY_ENABLED=false
# PGPA_HISTORY_DB_PATH=./data/pgplanadvisor.db
# PGPA_HISTORY_MAX_ROWS=500
